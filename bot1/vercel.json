{
    "version": 2,
    "builds": [
        { 
            "src": "1.index.js", 
            "use": "@vercel/node",
            "config": { 
                "includeFiles": ["dist**", "node_modules/**", ".env"]
            }
        }
    ],
    "routes": [
        { 
            "src": "/(.*)", 
            "dest": "1.index.js" 
        }
    ]
}